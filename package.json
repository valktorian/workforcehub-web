          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/router": "^21.2.18",
    "mixology-ui": "github:valktorian/Mixology-ui-#main",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.2.18",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "github:valktorian/Mixology-ui-#0e2f97a164d8c7665e6837653e9fc7e45b79af62": true,
    "esbuild@0.28.1": true
